# IdP Configuration

# ⚠️  The secrets below ship as "1234" for a zero-config LOCAL dev loop only.
# The bootstrap documents (idp/bootstrap/) and deployment.yaml are templated from
# this file, and an unset placeholder fails the whole bootstrap.

# Required: Admin user credentials used by the bootstrap container.
# In UAT/prod this admin is your management entry point (see idp/README.md) —
# ADMIN_PASSWORD MUST be a strong, unique secret there.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=1234

# Required: password of every sample user (idp/bootstrap/90-sample-data.yaml).
SAMPLE_USER_PASSWORD=1234

# Required: client secret of every M2M client in idp/bootstrap/. The backends'
# M2M_*_SECRET variables must match it.
M2M_CLIENT_SECRET=1234

# Required (local dev): client secret for the `admin-cli` bootstrap M2M client
# (client_id ADMIN_CLI), used by the dev stack to mint a `system`-scoped
# management token (see idp/README.md). admin-cli is a LOCAL-DEV convenience only
# and is not created in UAT/prod, so this is only needed for the compose stack.
ADMIN_CLI_SECRET=1234

# Required: Used by deployment.yaml placeholder
PUBLIC_URL=https://localhost:8090
PORT=8090
HOSTNAME=0.0.0.0

# Required if email SMTP is configured via deployment.yaml placeholders.
# Thunder startup fails if these are missing when placeholders are present.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=team@example.com
SMTP_PASSWORD=change-me
SMTP_FROM_ADDRESS=no-reply@example.com
SMTP_ENABLE_START_TLS=true
SMTP_ENABLE_AUTHENTICATION=true
