{
  "name": "portals-workspace",
  "version": "1.0.0",
  "description": "",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=24.15.0",
    "pnpm": ">=12.0.0"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "24.22.2",
      "onFail": "download"
    }
  },
  "scripts": {
    "build": "pnpm --recursive run build",
    "dev-trader": "pnpm --filter trader-app dev",
    "format:check": "prettier --check .",
    "format:fix": "prettier --write .",
    "lint": "pnpm --recursive --parallel run lint",
    "format": "pnpm format:fix && pnpm --recursive --parallel run format",
    "type-check": "pnpm --recursive --parallel run type-check",
    "test": "pnpm --recursive run test"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "private": true,
  "devDependencies": {
    "prettier": "^3.9.10"
  }
}
