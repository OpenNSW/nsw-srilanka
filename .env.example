# Copy this file to .env and adjust values for your local environment.
#
# Server settings are not here: they live in config.yaml (configs/config.yaml for
# a native run, configs/config.docker.yaml under Docker Compose — both seeded by
# `make setup`). What remains is the secrets those files and services*.json
# reference as {{env:NAME}} / env:NAME, and the host-side settings Docker
# Compose itself reads.

# Server config file for a native run (`go run ./cmd/server`). Compose pins
# its own, configs/config.docker.yaml.
CONFIG_PATH=./configs/config.yaml

# Database, as Docker Compose creates it (the db container; argus reuses it).
# The server, the otc CLI and the migrator read their own copy from the db
# section of config.yaml — keep the two in step. DB_PORT is the host port
# Postgres is published on: mostly 5432 for local Postgres, a different one
# avoids clashing with any existing local instance.
DB_PORT=55432
DB_USERNAME=postgres
DB_NAME=nsw_db
DB_SSLMODE=disable
# Referenced as {{env:DB_PASSWORD}} by db.postgres.password.
DB_PASSWORD=changeme

# Outbound M2M (NSW -> Agency): client secrets used by configs/services*.json to
# obtain client_credentials tokens for calling each agency's POST /api/v1/inject.
# Referenced as env:M2M_NSW_TO_<AGENCY>_SECRET; the reference fails loud at startup
# if unset. Must match the secret registered in the IdP for the NSW_TO_<AGENCY>
# client (dev default: 1234). SLPA's is the exception in who issues it: its CMS
# runs its own OAuth2 server, so M2M_NSW_TO_SLPA_SECRET is the secret SLPA issued
# for the CMS client (see the SLPA block below), not one registered in our IdP.
M2M_NSW_TO_NPQS_SECRET=1234
M2M_NSW_TO_FCAU_SECRET=1234
M2M_NSW_TO_CDA_SECRET=1234
M2M_NSW_TO_SLPA_SECRET=1234
M2M_NSW_TO_CUSTOMS_SECRET=1234
M2M_NSW_TO_SLTB_SECRET=1234

# Outbound (NSW -> Sri Lanka Customs ASYCUDA/CIG declarations API). Referenced
# as env:M2M_NSW_TO_ASYCUDA_SECRET by the "customs-asycuda" service in
# configs/services*.json. Set the real client_credentials secret in your local
# .env (gitignored); this placeholder only needs to be non-empty so startup
# succeeds in dev.
M2M_NSW_TO_ASYCUDA_SECRET=1234

# Signs presigned upload URLs for storage.type: local, referenced as
# {{env:STORAGE_LOCAL_PUT_SECRET}} by storage.local.putSecret. Use a long random
# value anywhere but a local dev run.
STORAGE_LOCAL_PUT_SECRET=local-dev-put-secret

# Notification gateway credentials, referenced by notification.providers.
NOTIFICATION_EMAIL_TOKEN=replace-with-actual-token
NOTIFICATION_SMS_PASSWORD=replace-with-actual-password

# Artifact loader
# Required for a private artifacts repo; reference it as
# {{env:ARTIFACT_GITHUB_TOKEN}} under artifactLoader.github.token.
# ARTIFACT_GITHUB_TOKEN=
# Offline alternative to the GitHub loader: the tnsw/ dir of a local clone of
# OpenNSW/one-trade-artifacts. Under Docker Compose it is the host side of a
# read-only bind mount at /app/artifacts (see compose.yml); a native run sets
# artifactLoader.local.root to it in config.yaml instead.
#   git clone https://github.com/OpenNSW/one-trade-artifacts.git <path>
# ARTIFACT_LOCAL_ROOT=../one-trade-artifacts/tnsw

# Trader Portal (Frontend) Configuration
# Host port for the trader portal (Nginx listens on 8080 inside the container).
TRADER_PORTAL_PORT=5173
# Browser-facing config no longer goes through this file — it's
# bind-mounted from apps/trader-app/public/config.js (see
# apps/trader-app/public/config.example.js and compose.yml).

# Multi-Repository Local Workspace Configuration (optional)
# Set GOWORK to '/src/go.work' to use local sibling directories instead of GitHub remote dependencies.
# GOWORK=/src/go.work
# CORE_PATH=../core
# CORE_REMOTE_PATH=../core/remote

# Audit Service Configuration (Argus)
ARGUS_PORT=3001
# Referenced as {{env:ARGUS_API_KEY}} by audit.apiKey.
ARGUS_API_KEY=nsw-super-secret-audit-token

# SLPA Cargo Management System (ECDN upload). SLPA runs its own OAuth2 server:
# the token is fetched with a standard client_credentials grant, form-urlencoded
# as core/remote sends it. The token URL and client id live in the services
# registry alongside every other service; only the secret is in .env, as
# M2M_NSW_TO_SLPA_SECRET above, named like every other agency's.
#
# The example registries point at a local mock. The live host belongs in a
# deployment overlay, never in a checked-in example — see configs/services.example.json.
#
# The per-company client key (slpacmsuser-key) is not this secret and is not set
# here: it is on the company profile (company.data.slpacmsuser_key), since SLPA
# issues one per registered company, and the artifact maps it onto the task.
# Shared with SLPA out of band; referenced as {{env:SLPA_WEBHOOK_SECRET}} by
# integrations.slpaWebhookSecret (see config.example.yaml). The value below is
# the local development default baked into compose.yml; a real deployment sets
# the secret SLPA shares with it.
SLPA_WEBHOOK_SECRET=local-dev-slpa-webhook-secret
