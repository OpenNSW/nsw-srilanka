# Environment for running the backend as the CDA agency, next to TNSW on the same
# machine. Values marked ASSUMED are placeholders to replace. Load with:
#   set -a; . configs/agency/cda/cda.env; set +a; go run ./cmd/server

# services.json skips TLS verification against the local IdP, which needs development.
APP_ENV=development

# Server. 8083 is where TNSW's services.json already points its "cda" service.
SERVER_PORT=8083
SERVER_LOG_LEVEL=debug
SERVICE_URL=http://localhost:8083

# Config files
CONFIG_PATH=./configs/agency/cda/config.yaml
CATALOG_CONFIG_PATH=./configs/agency/cda/catalog.json
SERVICES_CONFIG_PATH=./configs/agency/cda/services.json
PAYMENT_METHODS_CONFIG_PATH=./configs/agency/cda/payment_methods.json
NOTIFICATIONS_CONFIG_PATH=./configs/agency/cda/notification.json

# Database: its own database on the shared Postgres. ASSUMED name; create it before
# running migrations (CREATE DATABASE cda_db;).
DB_HOST=localhost
DB_PORT=55432
DB_USERNAME=postgres
DB_PASSWORD=changeme
DB_NAME=cda_db
DB_SSLMODE=disable

# Temporal: its own namespace, so TNSW and CDA workers never pick up each other's
# workflows. ASSUMED name; register it first (temporal operator namespace create cda).
TEMPORAL_HOST=localhost
TEMPORAL_PORT=7233
TEMPORAL_NAMESPACE=cda

# Artifacts: the cda-v2 folder of one-trade-artifacts (branch
# feat/add-cda-agency-config-to-workflows until it merges).
ARTIFACT_LOADER_TYPE=local
ARTIFACT_GITHUB_OWNER=OpenNSW
ARTIFACT_GITHUB_REPO=one-trade-artifacts
ARTIFACT_GITHUB_REF=feat/add-cda-agency-config-to-workflows
ARTIFACT_GITHUB_BASE_PATH=cda-v2
# Or from a local checkout:
# ARTIFACT_LOADER_TYPE=local
ARTIFACT_LOCAL_ROOT=../one-trade-artifacts/cda-v2

# Storage: its own bucket directory.
STORAGE_TYPE=local
STORAGE_LOCAL_BASE_DIR=./bucket-cda

# Authn. Officers sign in through the CDA portal client, and NSW injects as NSW_TO_CDA.
# The audience is the CDA API resource server in idp/resources/shared/resource-servers.json.
AUTH_JWKS_URL=https://localhost:8090/oauth2/jwks
AUTH_ISSUER=https://localhost:8090
AUTH_AUDIENCE=https://api.cda.nsw-agency.local
AUTH_CLIENT_IDS=OGA_PORTAL_APP_CDA,NSW_TO_CDA
AUTH_JWKS_INSECURE_SKIP_VERIFY=true

# Calls back into TNSW (services.json "tnsw").
M2M_CDA_TO_NSW_SECRET=1234

# CORS: the CDA portal (the trader-app in agency mode).
CORS_ALLOWED_ORIGINS=http://localhost:5176
CORS_ALLOWED_METHODS=GET,POST,PUT,DELETE,OPTIONS
CORS_ALLOWED_HEADERS=Content-Type,Authorization
CORS_ALLOW_CREDENTIALS=true
CORS_MAX_AGE=3600
