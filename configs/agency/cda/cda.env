# Environment for running the backend natively as the CDA agency, next to TNSW on
# the same machine. Every setting lives in config.yaml; this holds only what it
# cannot: its path, APP_ENV and the secrets it references. Load with:
#   set -a; . configs/agency/cda/cda.env; set +a; go run ./cmd/server

CONFIG_PATH=./configs/agency/cda/config.yaml

# Use APP_ENV=development only when enabling insecure TLS in config.yaml;
APP_ENV=development

# Referenced as {{env:...}} in config.yaml.
DB_PASSWORD=changeme
NOTIFICATION_EMAIL_TOKEN=replace-with-actual-token
NOTIFICATION_SMS_PASSWORD=replace-with-actual-password
# Local dev only, and not TNSW's: each deployment seals its own file tokens.
STORAGE_TOKEN_KEYSET=dev:Y2RhLWxvY2FsLWRldi1maWxlLXRva2VuLWtleS0wMDE=

# Calls back into TNSW (config.yaml services entry "tnsw").
M2M_CDA_TO_NSW_SECRET=1234
