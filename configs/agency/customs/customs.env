# Environment for running the backend natively as the Customs agency, next to TNSW on
# the same machine. Every setting lives in config.yaml; this holds only what it
# cannot: its path, APP_ENV and the secrets it and services.json reference. Load with:
#   set -a; . configs/agency/customs/customs.env; set +a; go run ./cmd/server

CONFIG_PATH=./configs/agency/customs/config.yaml

# config.yaml and services.json skip TLS verification against the local IdP,
# which needs development.
APP_ENV=development

# Referenced as {{env:...}} in config.yaml.
DB_PASSWORD=changeme
NOTIFICATION_EMAIL_TOKEN=replace-with-actual-token
NOTIFICATION_SMS_PASSWORD=replace-with-actual-password

# Calls back into TNSW (services.json "tnsw").
M2M_CUSTOMS_TO_NSW_SECRET=1234
