{
  "version": "1.0",
  "services": [
    {
      "id": "tnsw",
      "url": "http://localhost:8080",
      "timeout": "30s",
      "auth": {
        "type": "oauth2",
        "options": {
          "token_url": "https://localhost:8090/oauth2/token",
          "client_id": "CUSTOMS_TO_NSW",
          "client_secret": "env:M2M_CUSTOMS_TO_NSW_SECRET",
          "scopes": ["nsw:task:write", "nsw:storage:read", "nsw:storage:write", "nsw:storage:delete"],
          "insecure_skip_tls_verify": true,
          "endpoint_params": { "resource": "https://api.nsw-srilanka.local" }
        }
      }
    }
  ]
}
