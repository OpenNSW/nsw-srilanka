{
  "name": "sltb_application_rework",
  "steps": [
    {
      "name": "trader creates consignment",
      "request": {
        "actor": "trader",
        "method": "POST",
        "path": "/api/v1/consignments",
        "expectStatus": 201,
        "extract": {
          "consignmentId": "id"
        }
      }
    },
    {
      "name": "wait for Initialize Consignment task",
      "wait": {
        "node": "Initialize Consignment",
        "state": "IN_PROGRESS",
        "into": "initTask",
        "timeout": "45s"
      }
    },
    {
      "name": "trader reads the step initTask is on",
      "request": {
        "actor": "trader",
        "method": "GET",
        "path": "/api/v1/tasks/{{initTask}}",
        "extract": {
          "initTaskStep": "step_id"
        },
        "retry": "30s"
      }
    },
    {
      "name": "trader initializes consignment (name + CHA)",
      "request": {
        "actor": "trader",
        "method": "POST",
        "path": "/api/v1/tasks/{{initTask}}/steps/{{initTaskStep}}",
        "body": {
          "command": "submit",
          "payload": {
            "consignment_name": "E2E SLTB Rework Consignment",
            "cha_company_id": "adam-pvt-ltd"
          }
        },
        "expectStatus": 204
      }
    },
    {
      "name": "wait for HS-code selection task",
      "wait": {
        "node": "Select HS Codes",
        "state": "IN_PROGRESS",
        "into": "hsTask",
        "timeout": "45s"
      }
    },
    {
      "name": "cha reads the step hsTask is on",
      "request": {
        "actor": "cha",
        "method": "GET",
        "path": "/api/v1/tasks/{{hsTask}}",
        "extract": {
          "hsTaskStep": "step_id"
        },
        "retry": "30s"
      }
    },
    {
      "name": "cha selects the SLTB blendsheet HS code",
      "request": {
        "actor": "cha",
        "method": "POST",
        "path": "/api/v1/tasks/{{hsTask}}/steps/{{hsTaskStep}}",
        "body": {
          "command": "submit",
          "payload": {
            "hs_codes": [
              "sltb-blendsheet-approval"
            ]
          }
        },
        "expectStatus": 204
      }
    },
    {
      "name": "wait for SLTB application task (agency split fired)",
      "wait": {
        "node": "Submit & Review Blend Sheet",
        "state": "IN_PROGRESS",
        "into": "sltbApp",
        "timeout": "60s"
      }
    },
    {
      "name": "trader reads the step sltbApp is on",
      "request": {
        "actor": "trader",
        "method": "GET",
        "path": "/api/v1/tasks/{{sltbApp}}",
        "extract": {
          "sltbAppStep": "step_id"
        },
        "retry": "30s"
      }
    },
    {
      "name": "trader submits the SLTB blend sheet",
      "request": {
        "actor": "trader",
        "method": "POST",
        "path": "/api/v1/tasks/{{sltbApp}}/steps/{{sltbAppStep}}",
        "body": {
          "command": "submit",
          "payload": {
            "cusdec_draft": {
              "identification": {
                "officeCode": "CBEX1",
                "declarationType": "EX",
