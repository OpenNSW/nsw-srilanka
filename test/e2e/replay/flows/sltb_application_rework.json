          }
        },
        "expectStatus": 204
      }
    },
    {
      "name": "wait for SLTB application to reach officer review",
      "wait": {
        "node": "Submit & Review Blend Sheet",
        "state": "QUEUED_EXTERNALLY",
        "into": "sltbApp",
        "timeout": "60s"
      }
    },
    {
      "name": "SLTB agency sends the blend sheet back for more information",
      "callback": {
        "taskVar": "sltbApp",
        "command": "needs_more_info",
        "content": {
          "review_outcome": "needs_more_info",
          "feedback": "Please correct the garden mark on sale line 1."
        },
        "timeout": "60s"
      }
    },
    {
      "name": "wait for SLTB application to return to the trader",
      "wait": {
        "node": "Submit & Review Blend Sheet",
        "state": "IN_PROGRESS",
        "into": "sltbApp",
        "timeout": "60s"
      }
    },
    {
      "name": "trader reads the step sltbApp is on after rework",
      "request": {
        "actor": "trader",
        "method": "GET",
        "path": "/api/v1/tasks/{{sltbApp}}",
        "extract": {
          "sltbAppStep": "step_id",
          "sltbAppState": "state"
        },
        "retry": "30s",
        "extractEquals": {
          "sltbAppState": "PENDING_USER"
        }
      }
    },
    {
      "name": "trader resubmits the SLTB blend sheet",
      "request": {
        "actor": "trader",
        "method": "POST",
        "path": "/api/v1/tasks/{{sltbApp}}/steps/{{sltbAppStep}}",
        "body": {
          "command": "submit",
