    {
      "name": "wait for SLTB application to reach officer review again",
      "wait": {
        "node": "Submit & Review Blend Sheet",
        "state": "QUEUED_EXTERNALLY",
        "into": "sltbApp",
        "timeout": "60s"
      }
    },
    {
      "name": "SLTB agency approves the resubmitted blend sheet",
      "callback": {
        "taskVar": "sltbApp",
        "command": "approve",
        "content": {
          "review_outcome": "approve",
          "levy_amount": 15000
        },
        "timeout": "60s"
      }
    },
    {
      "name": "wait for SLTB pay-levy task (application approved & advanced)",
      "wait": {
        "node": "Pay SLTB Levy",
        "state": "IN_PROGRESS",
        "into": "payTask",
        "timeout": "60s"
      }
    },
    {
      "name": "trader reads the step payTask is on",
      "request": {
        "actor": "trader",
        "method": "GET",
        "path": "/api/v1/tasks/{{payTask}}",
        "extract": {
          "payTaskStep": "step_id"
        },
        "retry": "30s"
      }
    },
    {
      "name": "trader selects the payment method",
      "request": {
        "actor": "trader",
        "method": "POST",
        "path": "/api/v1/tasks/{{payTask}}/steps/{{payTaskStep}}",
        "body": {
          "command": "submit",
          "payload": {
            "selected_method": "govpay"
          }
        },
        "expectStatus": 204
      }
    },
    {
      "name": "payment gateway confirms the SLTB levy",
      "pay": {
        "taskVar": "payTask",
        "method": "govpay",
        "status": "paid",
        "timeout": "60s"
      }
    },
    {
      "name": "wait for the SLTB levy to be paid",
      "wait": {
        "node": "Pay SLTB Levy",
        "state": "COMPLETED",
        "timeout": "60s"
      }
    },
    {
      "name": "wait for SLTB tasting decision",
      "wait": {
        "node": "Tasting Decision",
        "state": "QUEUED_EXTERNALLY",
        "into": "tastingTask",
        "timeout": "60s"
      }
    },
    {
      "name": "SLTB officer decides tasting is not required",
      "callback": {
        "taskVar": "tastingTask",
        "command": "no",
        "content": {
          "tasting_required": "no"
        },
        "timeout": "60s"
      }
    },
    {
      "name": "wait for final SLTB decision task",
      "wait": {
        "node": "Final Application Decision",
        "state": "QUEUED_EXTERNALLY",
        "into": "finalDecision",
        "timeout": "60s"
      }
    },
    {
      "name": "SLTB agency issues the final approval",
      "callback": {
        "taskVar": "finalDecision",
        "command": "approve",
        "content": {
          "final_decision_outcome": "approve",
          "remarks": "E2E blend sheet approved."
        },
        "timeout": "60s"
      }
    },
    {
      "name": "wait for final SLTB decision to complete",
      "wait": {
        "node": "Final Application Decision",
        "state": "COMPLETED",
        "timeout": "60s"
      }
    }
  ]
}
