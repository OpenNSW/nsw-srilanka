{
  "name": "cda_application_value_added",
  "steps": [
    {
      "name": "trader creates consignment",
      "request": {
        "actor": "trader",
        "method": "POST",
        "path": "/api/v1/consignments",
        "expectStatus": 201,
        "extract": {
          "consignmentId": "id"
        }
      }
    },
    {
      "name": "wait for Initialize Consignment task",
      "wait": {
        "node": "Initialize Consignment",
        "state": "IN_PROGRESS",
        "into": "initTask",
        "timeout": "45s"
      }
    },
    {
      "name": "trader reads the step initTask is on",
      "request": {
        "actor": "trader",
        "method": "GET",
        "path": "/api/v1/tasks/{{initTask}}",
        "extract": {
          "initTaskStep": "step_id"
        },
        "retry": "30s"
      }
    },
    {
      "name": "trader initializes consignment (name + CHA)",
      "request": {
        "actor": "trader",
        "method": "POST",
        "path": "/api/v1/tasks/{{initTask}}/steps/{{initTaskStep}}",
        "body": {
          "command": "submit",
          "payload": {
            "consignment_name": "E2E CDA Value-Added Consignment",
            "cha_company_id": "adam-pvt-ltd"
          }
        },
        "expectStatus": 204
      }
    },
    {
      "name": "wait for HS-code selection task",
      "wait": {
        "node": "Select HS Codes",
        "state": "IN_PROGRESS",
        "into": "hsTask",
        "timeout": "45s"
      }
    },
    {
      "name": "cha reads the step hsTask is on",
      "request": {
        "actor": "cha",
        "method": "GET",
        "path": "/api/v1/tasks/{{hsTask}}",
        "extract": {
          "hsTaskStep": "step_id"
        },
        "retry": "30s"
      }
    },
    {
      "name": "cha selects the CDA coconut-certificate HS code",
      "request": {
        "actor": "cha",
        "method": "POST",
        "path": "/api/v1/tasks/{{hsTask}}/steps/{{hsTaskStep}}",
        "body": {
          "command": "submit",
          "payload": {
            "hs_codes": [
              "cda-certificate-reg"
            ]
          }
        },
        "expectStatus": 204
      }
    },
    {
      "name": "admin lists the consignment's flows",
      "request": {
        "actor": "admin",
        "method": "GET",
        "path": "/api/v1/admin/consignments/{{consignmentId}}",
        "extract": {
          "exportFlow": "flows.0.workflowId"
        },
        "retry": "30s"
      }
    },
    {
      "name": "emit assessed CusDec (stands in for Customs)",
      "signal": {
        "fromWorkflowVar": "exportFlow",
        "name": "cusdec_assessed",
        "payload": {
          "cusdec_number": "CBEX1/2026/E/904821"
        },
        "timeout": "60s"
      }
    },
    {
      "name": "wait for CDA application task (agency split fired)",
      "wait": {
        "node": "Submit Application",
        "state": "IN_PROGRESS",
        "into": "cdaApp",
        "timeout": "60s"
      }
    },
    {
      "name": "trader reads the step cdaApp is on",
      "request": {
        "actor": "trader",
        "method": "GET",
        "path": "/api/v1/tasks/{{cdaApp}}",
        "extract": {
          "cdaAppStep": "step_id"
        },
        "retry": "30s"
      }
    },
    {
      "name": "trader uploads the DC bags details spreadsheet",
      "upload": {
        "actor": "trader",
        "filename": "dc-bags.xlsx",
        "mimeType": "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet",
        "content": "PK\u0003\u0004e2e-xlsx",
        "into": "dcBags"
      }
    },
    {
      "name": "trader submits the CDA application (value-added path)",
      "request": {
        "actor": "trader",
        "method": "POST",
        "path": "/api/v1/tasks/{{cdaApp}}/steps/{{cdaAppStep}}",
        "body": {
          "command": "submit",
          "payload": {
            "exporter_name": "Lanka Coconuts Ltd",
            "exporter_registration_number": "0001",
            "exporter_address": "123 Galle Road, Colombo 03",
            "cusdec_number": "CBEX1/2026/E/904821",
            "relates_to_previous_approval": false,
            "product_type": "value_added_dc",
            "dc_grades": [
              {
                "dc_grade": "FINE",
                "number_of_bags": 500,
                "weight_of_bag": 25,
                "total_weight": 12500
              }
            ],
            "port_of_discharge": "Port of Rotterdam",
            "final_destination": "Rotterdam, Netherlands",
            "container_filling_status": "full",
            "cert_type": "PS",
            "uploaded_dc_bags_details": "{{dcBags}}"
          }
        },
        "expectStatus": 204
      }
    },
    {
      "name": "wait for CDA application to reach officer verification",
      "wait": {
        "node": "Submit Application",
        "state": "QUEUED_EXTERNALLY",
        "into": "cdaApp",
        "timeout": "60s"
      }
    },
    {
      "name": "CDA agency approves the value-added application",
      "callback": {
        "taskVar": "cdaApp",
        "command": "approve",
        "content": {
          "verification_outcome": "approve"
        },
        "timeout": "60s"
      }
    },
    {
      "name": "wait for CDA ASYCUDA green check (payment skipped)",
      "wait": {
        "node": "ASYCUDA Green Check",
        "state": "QUEUED_EXTERNALLY",
        "into": "greenCheck",
        "timeout": "60s"
      }
    },
    {
      "name": "CDA officer confirms the ASYCUDA green check",
      "callback": {
        "taskVar": "greenCheck",
        "command": "approve",
        "content": {
          "review_outcome": "approve",
          "asycuda_approval_confirmed": true
        },
        "timeout": "60s"
      }
    },
    {
      "name": "wait for ASYCUDA green check to complete",
      "wait": {
        "node": "ASYCUDA Green Check",
        "state": "COMPLETED",
        "timeout": "60s"
      }
    }
  ]
}
