{
  "name": "task_claims",
  "steps": [
    {
      "name": "trader creates consignment",
      "request": {
        "actor": "trader",
        "method": "POST",
        "path": "/api/v1/consignments",
        "expectStatus": 201,
        "extract": { "consignmentId": "id" }
      }
    },
    {
      "name": "wait for Initialize Consignment task",
      "wait": {
        "node": "Initialize Consignment",
        "state": "IN_PROGRESS",
        "into": "initTask",
        "timeout": "45s"
      }
    },
    {
      "name": "trader reads the task: the view carries the claim, which TNSW does not use",
      "request": {
        "actor": "trader",
        "method": "GET",
        "path": "/api/v1/tasks/{{initTask}}",
        "extract": { "claimRequired": "claim.required_to_submit" },
        "retry": "30s"
      }
    },
    {
      "name": "trader's token has no claim scope: claim is refused at the scope check",
      "request": {
        "actor": "trader",
        "method": "POST",
        "path": "/api/v1/tasks/{{initTask}}/claim",
        "expectStatus": 403
      }
    },
    {
      "name": "trader's token has no release scope: release is refused at the scope check",
      "request": {
        "actor": "trader",
        "method": "POST",
        "path": "/api/v1/tasks/{{initTask}}/release",
        "expectStatus": 403
      }
    },
    {
      "name": "a trader token that holds the claim scope still cannot claim: TNSW does not use claims",
      "request": {
        "actor": "trader_claims",
        "method": "POST",
        "path": "/api/v1/tasks/{{initTask}}/claim",
        "expectStatus": 404
      }
    },
    {
      "name": "...and cannot release",
      "request": {
        "actor": "trader_claims",
        "method": "POST",
        "path": "/api/v1/tasks/{{initTask}}/release",
        "expectStatus": 404
      }
    },
    {
      "name": "an agency's machine client, which holds nsw:task:write to answer callbacks, cannot claim",
      "request": {
        "actor": "fcau",
        "method": "POST",
        "path": "/api/v1/tasks/{{initTask}}/claim",
        "expectStatus": 403
      }
    }
  ]
}
