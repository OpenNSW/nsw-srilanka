{
  "name": "trade_up_to_hscode",
  "steps": [
    {
      "name": "trader creates consignment",
      "request": {
        "actor": "trader",
        "method": "POST",
        "path": "/api/v1/consignments",
        "expectStatus": 201,
        "extract": {
          "consignmentId": "id"
        }
      }
    },
    {
      "name": "wait for Initialize Consignment task",
      "wait": {
        "node": "Initialize Consignment",
        "state": "IN_PROGRESS",
        "into": "initTask",
        "timeout": "45s"
      }
    },
    {
      "name": "trader reads the pending CHA-selection task",
      "request": {
        "actor": "trader",
        "method": "GET",
        "path": "/api/v1/tasks/{{initTask}}",
        "expectStatus": 200
      }
    },
    {
      "name": "cha cannot read the CHA-selection task before being appointed",
      "request": {
        "actor": "cha",
        "method": "GET",
        "path": "/api/v1/tasks/{{initTask}}",
        "expectStatus": 404
      }
    },
    {
      "name": "trader initializes consignment (name + CHA)",
      "request": {
        "actor": "trader",
        "method": "POST",
        "path": "/api/v1/tasks/{{initTask}}",
        "body": {
          "command": "submit",
          "payload": {
            "consignment_name": "E2E Replay Consignment",
            "cha_company_id": "adam-pvt-ltd"
          }
        },
        "expectStatus": 204
      }
    },
    {
      "name": "wait for HS-code selection task",
      "wait": {
        "node": "Select HS Codes",
        "state": "IN_PROGRESS",
        "into": "hsTask",
        "timeout": "45s"
      }
    },
    {
      "name": "cha reads the HS-code task once appointed",
      "request": {
        "actor": "cha",
        "method": "GET",
        "path": "/api/v1/tasks/{{hsTask}}",
        "expectStatus": 200
      }
    },
    {
      "name": "trader still reads it too \u2014 both own the consignment",
      "request": {
        "actor": "trader",
        "method": "GET",
        "path": "/api/v1/tasks/{{hsTask}}",
        "expectStatus": 200
      }
    },
    {
      "name": "cha selects HS codes (FCAU flow)",
      "request": {
        "actor": "cha",
        "method": "POST",
        "path": "/api/v1/tasks/{{hsTask}}",
        "body": {
          "command": "submit",
          "payload": {
            "hs_codes": [
              "fcau-health-certificate-reg"
            ]
          }
        },
        "expectStatus": 204
      }
    },
    {
      "name": "wait for FCAU application to start (agency split fired)",
      "wait": {
        "node": "[FCAU] Apply for Health Certificate",
        "state": "IN_PROGRESS",
        "timeout": "60s"
      }
    }
  ]
}
