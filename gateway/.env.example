# Copy to gateway/.env (gitignored) and set real values — `make setup` does
# the copy — then set a real password:
#   cp gateway/.env.example gateway/.env
#
# Docker Compose reads gateway/.env automatically when run from gateway/.

# Login for the gateway's management API (deploying APIs, on :9190).
# Required: the gateway refuses to start without both. Any characters except a
# single quote (') are allowed; wrap a value containing "$" in single quotes.
GATEWAY_ADMIN_USERNAME=admin
GATEWAY_ADMIN_PASSWORD=change-me

# Host ports (optional; these are the defaults).
# GATEWAY_HTTP_PORT=8280
# GATEWAY_MANAGEMENT_PORT=9190
# GATEWAY_ADMIN_PORT=9094
